# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.env

# uv
.uv/

# Data
data/raw/
data/chroma/
data/*.json.gz
data/*.parquet

# Feedback + conversations (Day 6/7)
data/conversations/
data/feedback.csv

# Runtime logs
eval_run.log
eval_run.pid
eval_resume.log
# Root-level audit harness log. The `audit/` rule below is a directory and does
# NOT cover this file — it sits at the repo root and carries local Ollama
# output, so without this line it is one `git add -A` from publication.
audit_run.log

# v2 dossier work
# Rule: EVERY case is ignored except the two public fixtures, which are
# whitelisted by name. Inverted from naming `private/` explicitly (ADR #66):
# that form left any other case directory tracked, so a dossier created from
# the app — real client PDFs — was one `git add -A` from publication. Ignoring
# by default means a new case is safe without anyone remembering to add it.
#
# demo is the smoke fixture; vitrine is the anonymised public case derived
# from private (ADR #59, #62, #65) and the one the README's commands use.
data/dossier/*
!data/dossier/demo/
!data/dossier/demo/**
!data/dossier/vitrine/
!data/dossier/vitrine/**

# Backups
*.bak
.vscode/
tmp-chroma-test/

# Streamlit secrets (dossier passphrase, ADR #58) — never commit
.streamlit/secrets.toml

# Local audit harness output (scripts/local_audit/ itself is tracked) —
# machine-local findings/cache, regenerated every run.
audit/
