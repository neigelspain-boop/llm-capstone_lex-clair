# Copy to .streamlit/secrets.toml (gitignored) and set a real passphrase.
#
# Unlocks access to protected dossier cases in the Streamlit app (ADR #58).
# Without this key the app runs locked: statute-only chat, and the analysis
# tab offers public cases (demo) only. It never fails open.
#
# Scope of protection, stated plainly: this gates the APPLICATION, not the
# files. Anyone with filesystem or repo access to data/dossier/<case>/ reads
# it regardless. It is a second layer over filesystem permissions and a
# private deployment — not a substitute for either. Do not ship a real
# dossier to a public deployment and rely on this.

dossier_passphrase = "change-me"
