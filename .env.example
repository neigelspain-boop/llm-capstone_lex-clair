# OpenRouter — required for all LLM calls
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# PISTE / Légifrance — only needed if re-fetching statute corpus
PISTE_CLIENT_ID=your-piste-client-id
PISTE_CLIENT_SECRET=your-piste-client-secret

# Postgres — persistence + Grafana monitoring
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lexclair
POSTGRES_USER=lexclair
POSTGRES_PASSWORD=change-me

# Optional feature toggles (default: true)
LEXCLAIR_ENABLE_ROUTER=true
LEXCLAIR_ENABLE_REWRITE=true
