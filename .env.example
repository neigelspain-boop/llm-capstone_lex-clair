# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PISTE production credentials
# Register at https://piste.gouv.fr, subscribe to "DILA - Légifrance"
# Accept CGU under API > Consentement CGU API
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# Optional sandbox for testing before production
PISTE_SANDBOX_CLIENT_ID=
PISTE_SANDBOX_CLIENT_SECRET=

# Set to "sandbox" during development, "production" for full fetch
PISTE_ENV=production

# --- Interface selection: fastapi | streamlit ---
# Drives which docker-compose profile you run (see docker-compose.yml)
INTERFACE=fastapi

# --- Vector store selection: qdrant | chroma ---
VECTOR_STORE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=capstone
CHROMA_PERSIST_DIR=/data/chroma
CHROMA_COLLECTION=capstone

# --- Postgres (feedback + monitoring logs) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=capstone
POSTGRES_USER=capstone
POSTGRES_PASSWORD=capstone

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
